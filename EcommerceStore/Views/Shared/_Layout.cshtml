@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexus Commerce</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom box-shadow mb-3" style="background-color: #2d3e1e;">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold fs-4 text-warning" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop me-2"></i>NEXUS STORE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="SalesOrder" asp-action="Create">
                                <i class="bi bi-grid me-1"></i> Storefront
                            </a>
                        </li>

                        @if (HttpContextAccessor.HttpContext?.Session.GetString("UserRole") == "Customer")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="SalesOrder" asp-action="MyOrders">
                                    <i class="bi bi-clock-history me-1"></i> My Orders
                                </a>
                            </li>
                        }

                        @if (HttpContextAccessor.HttpContext?.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Account" asp-action="AdminDashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Admin Panel
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Products" asp-action="Index">
                                    <i class="bi bi-box-seam me-1"></i> Manage Products
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="GRN" asp-action="Create">
                                    <i class="bi bi-box-arrow-in-down me-1"></i> Stock In (GRN)
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (HttpContextAccessor.HttpContext?.Session.GetString("UserName") != null)
                        {
                            <span class="text-white-50 small">
                                Signed in: <strong class="text-white">@HttpContextAccessor.HttpContext.Session.GetString("UserName")</strong>
                                <span class="badge bg-secondary ms-1">@HttpContextAccessor.HttpContext.Session.GetString("UserRole")</span>
                            </span>
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Logout">Logout</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-warning btn-sm rounded-pill px-3 text-dark fw-semibold" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; 2026 - Nexus Commerce System - All Rights Reserved</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>