@model EcommerceStore.Models.SalesOrder

@{
    ViewData["Title"] = "Order Confirmation";
    var details = ViewBag.Details as List<EcommerceStore.Models.SalesOrderDetails>;
}

<div class="container mt-5">
    <div class="card shadow-sm border-success">
        <div class="card-header bg-success text-white text-center">
            <h3><i class="bi bi-check-circle"></i> Order Placed Successfully!</h3>
        </div>
        <div class="card-body">
            <h5>Order Summary</h5>
            <p><strong>Order ID:</strong> #@Model.OrderID</p>
            <p><strong>Order Date:</strong> @Model.OrderDate.ToString("f")</p>
            <p><strong>Total Amount Paid:</strong> <span class="text-success fw-bold">$@Model.TotalAmount.ToString("F2")</span></p>

            <hr />
            <h5>Purchased Items</h5>
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (details != null)
                    {
                        foreach (var item in details)
                        {
                            <tr>
                                <td>@(item.Product != null ? item.Product.Name : "Product #" + item.ProductID)</td>
                                <td>@item.QuantitySold</td>
                                <td>$@item.UnitPrice.ToString("F2")</td>
                                <td>$@((item.QuantitySold * item.UnitPrice).ToString("F2"))</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-between mt-4">
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">Continue Shopping</a>
                <button onclick="window.print()" class="btn btn-secondary"><i class="bi bi-printer"></i> Print Receipt</button>
            </div>
        </div>
    </div>
</div>