@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<EcommerceStore.Models.Product>

@{
    ViewData["Title"] = "Store Catalog";
    var categories = ViewBag.Categories as List<EcommerceStore.Models.Category>;
    var natureTypes = ViewBag.NatureTypes as List<EcommerceStore.Models.BusinessNatureType>;
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
}

<div class="container-fluid py-4 px-4 min-vh-100">
    <!-- Header Controls -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom bg-white p-3 rounded-3 shadow-sm">
        <div>
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-bag-heart text-beige me-2"></i>Explore Products</h3>
            <p class="text-muted small mb-0">Browse items across departments, inspect details, and manage your cart.</p>
        </div>

        @if (userRole != "Admin")
        {
            <button class="btn btn-dark position-relative rounded-pill px-4" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartDrawer">
                <i class="bi bi-cart3 me-2 text-beige"></i> Cart
                <span id="cartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
            </button>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Bar -->
    <form method="get" action="/SalesOrder/Create" class="row g-3 mb-4">
        <div class="col-md-3">
            <select name="natureTypeId" class="form-select shadow-sm" onchange="this.form.submit()">
                <option value="">All Business Natures</option>
                @if (natureTypes != null)
                {
                    foreach (var n in natureTypes)
                    {
                        <option value="@n.NatureTypeID" selected="@(ViewBag.SelectedNature == n.NatureTypeID)">@n.TypeName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select shadow-sm" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @if (categories != null)
                {
                    foreach (var c in categories)
                    {
                        <option value="@c.CategoryID" selected="@(ViewBag.SelectedCategory == c.CategoryID)">@c.CategoryName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="sortBy" class="form-select shadow-sm" onchange="this.form.submit()">
                <option value="">Default Sorting</option>
                <option value="price_asc" selected="@(ViewBag.SortBy == "price_asc")">Price: Low to High</option>
                <option value="price_desc" selected="@(ViewBag.SortBy == "price_desc")">Price: High to Low</option>
                <option value="name_asc" selected="@(ViewBag.SortBy == "name_asc")">Name: A to Z</option>
            </select>
        </div>
        <div class="col-md-3">
            <div class="input-group shadow-sm">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search product..." />
                <button class="btn btn-beige" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </div>
    </form>

    <!-- Product Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card card-custom h-100 bg-white overflow-hidden shadow-sm">
                        <div class="position-relative overflow-hidden" style="height: 200px; background-color: #f8f9fa;">
                            <img src="@(string.IsNullOrEmpty(item.ImageURL) ? "https://images.unsplash.com/photo-1560343090-f0409e92791a?w=500&q=80" : item.ImageURL)"
                                 class="w-100 h-100 object-fit-cover"
                                 alt="@item.Name"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1560343090-f0409e92791a?w=500&q=80';" />

                            <div class="position-absolute top-0 end-0 p-2">
                                @if (item.StockQuantity > 0)
                                {
                                    <span class="badge bg-success shadow-sm">In Stock: @item.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger shadow-sm">Out of Stock</span>
                                }
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-dark border small fw-semibold">@(item.Category != null ? item.Category.CategoryName : "General")</span>
                                <span class="badge badge-nature small">@(item.BusinessNatureType != null ? item.BusinessNatureType.TypeName : "Retail")</span>
                            </div>

                            <h5 class="fw-bold text-dark mb-1">@item.Name</h5>
                            <p class="text-muted small mb-3">Unit Pack: @item.PackSize</p>

                            <div class="mt-auto d-flex align-items-center justify-content-between pt-3 border-top">
                                <div>
                                    <span class="text-muted small d-block">Price</span>
                                    <span class="h5 fw-bold text-dark mb-0">$@item.UnitPrice.ToString("F2")</span>
                                </div>

                                <div class="d-flex gap-2 align-items-center">
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle"
                                            onclick="showProductDetails('@item.Name', '@(item.Category != null ? item.Category.CategoryName : "N/A")', '@(item.BusinessNatureType != null ? item.BusinessNatureType.TypeName : "N/A")', '@item.PackSize', '$@item.UnitPrice.ToString("F2")', @item.StockQuantity)">
                                        <i class="bi bi-info-circle"></i>
                                    </button>

                                    @if (userRole == "Admin")
                                    {
                                        <span class="badge bg-light text-secondary border px-2 py-1.5 small">Preview Mode</span>
                                    }
                                    else
                                    {
                                        @if (item.StockQuantity > 0)
                                        {
                                            <button type="button" class="btn btn-beige btn-sm rounded-pill px-3" onclick="addToCart(@item.ProductID, '@item.Name', @item.UnitPrice, @item.StockQuantity)">
                                                + Add
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" disabled>
                                                Sold Out
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-search display-1 text-muted opacity-50"></i>
                <h4 class="mt-3 text-secondary">No products matched your search filter.</h4>
                <a href="/SalesOrder/Create" class="btn btn-link text-beige">Reset Filters</a>
            </div>
        }
    </div>
</div>

<!-- Customer Product Details Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold modal-title" id="modalProductName">Product Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="bg-light p-3 rounded mb-3">
                    <div class="row g-2">
                        <div class="col-6"><span class="text-muted small">Category:</span> <strong id="modalCategory" class="d-block text-dark"></strong></div>
                        <div class="col-6"><span class="text-muted small">Business Nature:</span> <strong id="modalNature" class="d-block text-dark"></strong></div>
                        <div class="col-6"><span class="text-muted small">Pack Size:</span> <strong id="modalPack" class="d-block text-dark"></strong></div>
                        <div class="col-6"><span class="text-muted small">Unit Price:</span> <strong id="modalPrice" class="d-block text-success fs-5"></strong></div>
                        <div class="col-12 border-top pt-2 mt-2"><span class="text-muted small">Available Stock:</span> <strong id="modalStock" class="d-block text-dark"></strong></div>
                    </div>
                </div>
                <p class="text-muted small mb-0">Verified quality item supplied under standard commerce policies with fast delivery options available at checkout.</p>
            </div>
        </div>
    </div>
</div>

<!-- Off-Canvas Cart Drawer -->
@if (userRole != "Admin")
{
    <div class="offcanvas offcanvas-end border-0 shadow-lg" tabindex="-1" id="cartDrawer">
        <div class="offcanvas-header bg-dark text-white py-3">
            <h5 class="offcanvas-title fw-bold" id="cartDrawerLabel"><i class="bi bi-bag-check text-beige me-2"></i> Your Shopping Order</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <form id="checkoutForm" method="post" action="/SalesOrder/Create">
                @Html.AntiForgeryToken()
                <div id="cartItemsContainer" class="flex-grow-1">
                    <p class="text-muted text-center py-5">Your cart is empty.</p>
                </div>
                <div class="border-top pt-3 mt-auto">
                    <div class="d-flex justify-content-between h5 fw-bold mb-3">
                        <span>Total:</span>
                        <span id="cartTotalDisplay" class="text-dark">$0.00</span>
                    </div>
                    <button type="button" id="checkoutBtn" onclick="submitCheckoutForm()" class="btn btn-beige w-100 py-2.5 fw-bold rounded-3" disabled>
                        Proceed to Checkout
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Toast Container for Notifications -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="cartToast" class="toast align-items-center text-white border-0 shadow-lg" style="background-color: #2d3e1e;" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-semibold">
                <i class="bi bi-check-circle-fill text-warning me-2"></i> <span id="toastMessage">Item added to your cart!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script>
    let cart = [];

    function addToCart(id, name, price, maxStock) {
        let existing = cart.find(item => item.id === id);
        if (existing) {
            if (existing.qty + 1 > maxStock) {
                showToast(`Cannot add more. Only ${maxStock} items in stock!`);
                return;
            }
            existing.qty += 1;
        } else {
            cart.push({ id: id, name: name, price: price, qty: 1, maxStock: maxStock });
        }
        renderCart();
        showToast(`"${name}" added to cart!`);
    }

    function removeFromCart(id) {
        cart = cart.filter(item => item.id !== id);
        renderCart();
    }

    function updateQty(id, qty) {
        let item = cart.find(i => i.id === id);
        if (item) {
            let requestedQty = parseInt(qty) || 0;
            if (requestedQty > item.maxStock) {
                alert(`Stock limit reached! Only ${item.maxStock} units available.`);
                item.qty = item.maxStock;
            } else if (requestedQty <= 0) {
                removeFromCart(id);
                return;
            } else {
                item.qty = requestedQty;
            }
        }
        renderCart();
    }

    function renderCart() {
        const container = document.getElementById("cartItemsContainer");
        const badge = document.getElementById("cartBadge");
        const totalDisplay = document.getElementById("cartTotalDisplay");
        const checkoutBtn = document.getElementById("checkoutBtn");

        if (!container || !badge || !totalDisplay || !checkoutBtn) return;

        let totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
        badge.innerText = totalCount;

        if (cart.length === 0) {
            container.innerHTML = '<p class="text-muted text-center py-5">Your cart is empty.</p>';
            totalDisplay.innerText = '$0.00';
            checkoutBtn.disabled = true;
            return;
        }

        let html = '';
        let total = 0;

        cart.forEach((item, index) => {
            let subtotal = item.qty * item.price;
            total += subtotal;

            html += `
                    <div class="card mb-3 border-0 bg-light p-3 rounded-3 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark">${item.name}</h6>
                            <button type="button" class="btn btn-sm text-danger p-0 border-0" onclick="removeFromCart(${item.id})">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <input type="hidden" name="details[${index}].ProductID" value="${item.id}" />
                            <input type="hidden" name="details[${index}].UnitPrice" value="${item.price}" />
                            <div class="input-group input-group-sm w-50">
                                <input type="number" min="1" max="${item.maxStock}" name="details[${index}].QuantitySold" value="${item.qty}" class="form-control" onchange="updateQty(${item.id}, this.value)" />
                            </div>
                            <span class="fw-bold text-dark">$${subtotal.toFixed(2)}</span>
                        </div>
                    </div>
                `;
        });

        container.innerHTML = html;
        totalDisplay.innerText = '$' + total.toFixed(2);
        checkoutBtn.disabled = false;
    }

    function submitCheckoutForm() {
        if (cart.length === 0) return;
        document.getElementById("checkoutForm").submit();
    }

    function showProductDetails(name, category, nature, pack, price, stock) {
        document.getElementById("modalProductName").innerText = name;
        document.getElementById("modalCategory").innerText = category;
        document.getElementById("modalNature").innerText = nature;
        document.getElementById("modalPack").innerText = pack;
        document.getElementById("modalPrice").innerText = price;
        document.getElementById("modalStock").innerText = stock + " units available";
        new bootstrap.Modal(document.getElementById('productModal')).show();
    }

    function showToast(message) {
        document.getElementById("toastMessage").innerText = message;
        const toastEl = document.getElementById('cartToast');
        const toast = new bootstrap.Toast(toastEl, { delay: 2500 });
        toast.show();
    }
</script>