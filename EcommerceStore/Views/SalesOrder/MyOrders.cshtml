@model IEnumerable<EcommerceStore.Models.SalesOrder>

@{
    ViewData["Title"] = "My Orders";
    var allDetails = ViewBag.AllOrderDetails as List<EcommerceStore.Models.SalesOrderDetails> ?? new List<EcommerceStore.Models.SalesOrderDetails>();
}

<div class="container py-4 min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom bg-white p-3 rounded-3 shadow-sm">
        <div>
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-warning"></i>My Order History</h3>
            <p class="text-muted small mb-0">Track and view all your placed purchase orders.</p>
        </div>
        <a asp-action="Create" class="btn btn-outline-dark rounded-pill px-4 btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Shop
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                var orderItems = allDetails.Where(d => d.OrderID == order.OrderID).ToList();

                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                            <div>
                                <span class="fw-bold text-dark me-2">Order #@order.OrderID</span>
                                <span class="text-muted small">Placed on @order.OrderDate.ToString("MMM dd, yyyy - hh:mm tt")</span>
                            </div>
                            <div>
                                <span class="badge bg-success px-3 py-2 rounded-pill">Completed</span>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <div class="table-responsive">
                                <table class="table table-borderless align-middle mb-0">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th>Product</th>
                                            <th>Unit Price</th>
                                            <th>Quantity</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (orderItems.Any())
                                        {
                                            @foreach (var item in orderItems)
                                            {
                                                <tr>
                                                    <td class="fw-semibold text-dark">
                                                        @(item.Product != null ? item.Product.Name : "Product #" + item.ProductID)
                                                    </td>
                                                    <td>$@item.UnitPrice.ToString("F2")</td>
                                                    <td>@item.QuantitySold</td>
                                                    <td class="text-end fw-bold">$@((item.UnitPrice * item.QuantitySold).ToString("F2"))</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-muted text-center py-2">No item details recorded for this order.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Total Items: @orderItems.Sum(d => d.QuantitySold)</span>
                            <div class="h5 fw-bold text-dark mb-0">
                                Total Amount: <span style="color: #2d3e1e;">$@order.TotalAmount.ToString("F2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-3 shadow-sm p-4">
            <i class="bi bi-bag-x display-1 text-muted opacity-50"></i>
            <h4 class="mt-3 text-secondary">You haven't placed any orders yet.</h4>
            <a asp-action="Create" class="btn text-white px-4 py-2 mt-2 rounded-pill fw-bold" style="background-color: #2d3e1e;">Start Shopping</a>
        </div>
    }
</div>