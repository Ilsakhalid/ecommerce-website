@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    <div class="text-center py-5 bg-white rounded-4 shadow-sm mb-5 px-4">
        <h1 class="display-4 fw-bold text-dark mb-3">Welcome to Nexus Store</h1>
        <p class="lead text-muted max-w-2xl mx-auto mb-4">Discover premium products across multiple departments with direct ordering and instant receipt generation.</p>
        <a asp-controller="SalesOrder" asp-action="Create" class="btn btn-beige btn-lg rounded-pill px-5 shadow-sm">
            Explore Storefront <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>

    @if (Context.Session.GetString("UserRole") == "Admin")
    {
        <!-- ADMIN ONLY MANAGEMENT CARDS -->
        <div class="border-top pt-4">
            <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-shield-lock me-2"></i>Administrator Quick Controls</h5>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card card-custom h-100 bg-white p-4">
                        <h5 class="fw-bold">Product Catalog</h5>
                        <p class="text-muted small">Manage items, pricing, and pack sizes.</p>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill mt-auto">Manage Products</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card card-custom h-100 bg-white p-4">
                        <h5 class="fw-bold">Executive Panel</h5>
                        <p class="text-muted small">View gross revenue and customer sales order history.</p>
                        <a asp-controller="Account" asp-action="AdminDashboard" class="btn btn-outline-dark btn-sm rounded-pill mt-auto">Open Admin Dashboard</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>